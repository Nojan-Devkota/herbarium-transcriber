# Copy to .env and fill in. .env is git-ignored.

# Meta Model API (https://dev.meta.ai/docs)
META_API_KEY=your-meta-model-api-key
META_BASE_URL=https://api.meta.ai/v1

# Model names
MODEL_SPARK=muse-spark-1.3
MODEL_SAM=sam-3.1

# "meta" calls the real API; "mock" uses the offline fake client (tests, UI dev)
LLM_CLIENT=meta

# Reasoning effort per Spark call type: minimal | low | medium | high
EFFORT_TRANSCRIBE=low
EFFORT_INTERPRET=low
EFFORT_REREAD=medium

# Where the SQLite DB, images, crops and the model-call cache live
# (relative paths are resolved against backend/, wherever a command is run from)
DATA_DIR=./data

# Requests that spend API credit or change data are accepted from localhost only.
# Set true only behind your own authentication.
ALLOW_REMOTE_WRITES=false

# Optional: locality -> coordinates via OpenStreetMap Nominatim (nice-to-have, off by default)
GEOCODE_ENABLED=false
